<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardDashboardItem"
    android:layout_width="100dp"
    android:layout_height="100dp"
    android:layout_margin="8dp"
    app:cardBackgroundColor="@color/cardBackground"
    app:cardCornerRadius="24dp"
    app:cardElevation="4dp"
    app:strokeColor="@color/cardBorder"
    app:strokeWidth="1dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="10dp">

        <TextView
            android:id="@+id/tvDashboardIcon"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_soft_chip"
            android:gravity="center"
            android:text="🌾"
            android:textSize="24sp" />

        <TextView
            android:id="@+id/tvDashboardTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="Find Farmers"
            android:textColor="@color/colorTextPrimary"
            android:textSize="10sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/tvDashboardSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:maxLines="2"
            android:ellipsize="end"
            android:text="Hire local farmers"
            android:textColor="@color/colorTextSecondary"
            android:textSize="8sp" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>